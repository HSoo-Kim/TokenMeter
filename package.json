{
  "name": "tokenmeter",
  "version": "1.3.0",
  "description": "Windows tray monitor for Codex, Claude, Gemini and Antigravity quota",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test:providers": "node --test test-gemini.cjs test-gemini-web.cjs test-antigravity.cjs",
    "test:updates": "node --test test-updates.cjs",
    "test:updates-ui": "electron test-updates-ui.cjs",
    "test:ui": "electron test-gemini-ui.cjs",
    "icon": "node build/make-icon.js",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "license": "MIT",
  "build": {
    "appId": "com.hsookim.tokenmeter",
    "productName": "TokenMeter",
    "copyright": "Copyright (c) 2026 HSoo-Kim",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "providers.js",
      "gemini.js",
      "gemini-web.js",
      "antigravity.js",
      "i18n.js",
      "updates.js",
      "index.html",
      "LICENSE"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "TokenMeter-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TokenMeter",
      "deleteAppDataOnUninstall": false
    }
  }
}
